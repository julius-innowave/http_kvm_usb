# Copy to .env and edit:  cp env.example .env
# Loaded at start-up; real environment variables win over it.

# HTTP
INNO_PORT=9150
INNO_API_KEY=test123

# The TARGET computer's real screen resolution (the /mouse coordinate space)
INNO_SCREEN_WIDTH=1920
INNO_SCREEN_HEIGHT=1080

# Capture card (HDMI → USB). "none" disables video (placeholder frames).
INNO_VIDEO_DEVICE=/dev/video0
# INNO_CAPTURE_WIDTH=1920
# INNO_CAPTURE_HEIGHT=1080
# INNO_VIDEO_FPS=30
# INNO_VIDEO_PIXEL=MJPG

# true: refuse input (409) while the board is in LOCAL.
# false: take control automatically (the board returns to LOCAL after a power cycle).
INNO_RESPECT_LOCAL=true

# signed (default) or unsigned — switch if (0,0) lands in the middle of the screen
# INNO_USB_ABS_RANGE=signed

# auto (default): ACK/sequence numbers on legacy firmware only
# INNO_SEQUENCE=auto
